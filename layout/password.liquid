<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>
    {{ shop.name }} &mdash; 
    {%- if request.locale.iso_code == 'ur' -%}
      {{ 'general.password_page.coming_soon' | t | default: 'جلد آ رہا ہے' }}
    {%- else -%}
      {{ 'general.password_page.coming_soon' | t | default: 'Coming Soon' }}
    {%- endif -%}
  </title>
  {{ content_for_header }}
  <style>
    body { margin:0; display:flex; align-items:center; justify-content:center; min-height:100vh; background: linear-gradient(135deg,#0E3A2F,#0a241e); color:white; font-family:'Inter',sans-serif; }
    .password-page { text-align:center; padding:40px 24px; max-width:480px; }
    .password-logo { font-size:2.5rem; margin-bottom:16px; }
    .password-subtitle { font-size:1.1rem; color:rgba(255,255,255,.75); margin-bottom:32px; }
    .password-form { display:flex; gap:10px; flex-direction:column; }
    .password-input { padding:14px 18px; border:2px solid rgba(255,255,255,.3); border-radius:50px; background:rgba(255,255,255,.1); color:white; font-size:0.95rem; outline:none; text-align:center; }
    .password-input::placeholder { color:rgba(255,255,255,.5); }
    .password-btn { padding:14px 28px; background:#DCA257; color:white; border:none; border-radius:50px; font-size:1rem; cursor:pointer; }
    .password-btn:hover { background:#b58140; }
    .password-links { margin-top:24px; font-size:0.85rem; color:rgba(255,255,255,.5); }
    .password-links a { color:rgba(255,255,255,.7); text-decoration:underline; }
  </style>
</head>
<body>
  {{ content_for_layout }}
</body>
</html>
