{% comment %}
  KITAB WALA - 3D PRODUCT CARD SNIPPET
  Full 3D CSS book effect with spine + cover
  Usage: {% render 'product-card-3d', product: product %}
{% endcomment %}

{%- assign product_url = product.url -%}
{%- assign first_image = product.featured_image -%}
{%- assign product_title_ur = product.title -%}
{%- if product.metafields.custom.title_urdu != blank -%}
  {%- assign product_title_ur = product.title | append: ' - ' | append: product.metafields.custom.title_urdu -%}
{%- endif -%}

<div class="product-card-3d-wrapper">
  <a href="{{ product_url }}" class="book-3d-container" aria-label="{{ product_title_ur }}">
    <div class="book-3d {% if section.settings.auto_spin %}auto-spin{% endif %}">
      <!-- Book Cover -->
      <div class="book-face book-front">
        {%- if first_image -%}
          <img
            src="{{ first_image | image_url: width: 300 }}"
            alt="{{ first_image.alt | escape | default: product_title_ur }}"
            loading="lazy"
            width="300"
            height="400"
          >
        {%- else -%}
          <div class="book-placeholder">
            <span style="font-size:3rem;">📚</span>
            <span style="font-size:0.9rem;text-align:center;padding:8px;">{{ product_title_ur }}</span>
          </div>
        {%- endif -%}
      </div>
      <!-- Book Spine -->
      <div class="book-spine">
        <span class="book-spine-text">{{ product_title_ur | truncate: 30 }}</span>
      </div>
    </div>
    <div class="book-3d-shadow"></div>
  </a>
</div>

<style>
  .book-3d-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    perspective: 1000px;
    padding: 20px;
  }
  .book-3d {
    position: relative;
    width: 160px;
    height: 220px;
    transform-style: preserve-3d;
    transform: rotateY(-20deg);
    transition: transform 0.8s cubic-bezier(0.4,0,0.2,1);
    cursor: pointer;
  }
  .book-3d:hover {
    transform: rotateY(0deg) rotateX(5deg);
  }
  .book-face {
    position: absolute;
    width: 160px;
    height: 220px;
    border-radius: 2px 6px 6px 2px;
    overflow: hidden;
    backface-visibility: hidden;
    box-shadow: 4px 4px 24px rgba(0,0,0,0.3);
  }
  .book-face img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .book-front {
    transform: translateZ(12px);
    background: var(--color-bg-warm, #f9f7f2);
  }
  .book-spine {
    position: absolute;
    left: -24px;
    top: 0;
    width: 24px;
    height: 220px;
    background: var(--color-primary, #1a3a52);
    transform: rotateY(-90deg) translateX(-12px);
    transform-origin: right center;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 2px 0 0 2px;
  }
  .book-spine-text {
    font-size: 0.6rem;
    color: rgba(255,255,255,0.85);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    padding: 4px 0;
    max-height: 90%;
    overflow: hidden;
  }
  .book-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-primary,#1a3a52), #2a5a7a);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: white;
    gap: 8px;
    padding: 12px;
  }
</style>
