{% comment %}
  KITAB WALA - MOBILE SIDEBAR MENU
  Contains the 11 navigation options, strictly in English, with complete URLs.
{% endcomment %}

<div id="sidebar-overlay" class="sidebar-overlay" aria-hidden="true"></div>

<nav id="sidebar-menu" class="sidebar-menu" role="navigation" aria-label="Navigation Menu" style="background: var(--color-primary); color: white;">
  <div class="sidebar-header" style="border-bottom: 1px solid rgba(255,255,255,0.1); padding: 18px 20px;">
    <span class="sidebar-logo" style="font-weight: 700; color: white;">
      {%- if request.locale.iso_code == 'ur' -%}مینو{%- else -%}Navigation{%- endif -%}
    </span>
    <button id="sidebar-close" class="sidebar-close" aria-label="Close" style="background: none; border: none; color: white; font-size: 1.2rem; cursor: pointer;">✕</button>
  </div>

  <ul class="sidebar-nav" role="list" style="list-style: none; padding: 20px 0; margin: 0; max-height: calc(100vh - 80px); overflow-y: auto;">
    <!-- 1. Home -->
    <li>
      <a href="{{ section.settings.nav_1_url | default: '/' }}" class="sidebar-nav-item {% if template.name == 'index' %}active{% endif %}" style="color: white; padding: 12px 20px; display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 600;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        {%- if request.locale.iso_code == 'ur' -%}ہوم{%- else -%}Home{%- endif -%}
      </a>
    </li>

    <!-- 2. Languages Dropdown -->
    <li class="sidebar-dropdown-wrapper">
      <button class="sidebar-nav-item dropdown-trigger" aria-expanded="false" style="width: 100%; text-align: left; background: none; border: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; color: white; padding: 12px 20px; font-weight: 600; font-family: inherit; font-size: 1rem;">
        <span style="display: flex; align-items: center; gap: 10px;">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          {%- if request.locale.iso_code == 'ur' -%}زبانیں{%- else -%}Languages{%- endif -%}
        </span>
        <span class="dropdown-arrow">▼</span>
      </button>
      <ul class="sidebar-dropdown-menu" style="display: none; padding-left: 28px; list-style: none; margin: 8px 0;">
        <li><a href="/collections/urdu-books" class="sidebar-sub-item" style="color: #FBF7EE; opacity: 0.85; padding: 8px 12px; display: block; text-decoration: none; font-size: 0.9rem;">{%- if request.locale.iso_code == 'ur' -%}اردو کتب{%- else -%}Urdu Books{%- endif -%}</a></li>
        <li><a href="/collections/punjabi-books" class="sidebar-sub-item" style="color: #FBF7EE; opacity: 0.85; padding: 8px 12px; display: block; text-decoration: none; font-size: 0.9rem;">{%- if request.locale.iso_code == 'ur' -%}پنجابی کتب{%- else -%}Punjabi Books{%- endif -%}</a></li>
        <li><a href="/collections/english-books" class="sidebar-sub-item" style="color: #FBF7EE; opacity: 0.85; padding: 8px 12px; display: block; text-decoration: none; font-size: 0.9rem;">{%- if request.locale.iso_code == 'ur' -%}انگریزی کتب{%- else -%}English Books{%- endif -%}</a></li>
      </ul>
    </li>

    <!-- 3. Categories Dropdown -->
    <li class="sidebar-dropdown-wrapper">
      <button class="sidebar-nav-item dropdown-trigger" aria-expanded="false" style="width: 100%; text-align: left; background: none; border: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; color: white; padding: 12px 20px; font-weight: 600; font-family: inherit; font-size: 1rem;">
        <span style="display: flex; align-items: center; gap: 10px;">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
          {%- if request.locale.iso_code == 'ur' -%}کتابوں کی اقسام{%- else -%}Categories{%- endif -%}
        </span>
        <span class="dropdown-arrow">▼</span>
      </button>
      <ul class="sidebar-dropdown-menu" style="display: none; padding-left: 28px; list-style: none; margin: 8px 0; max-height: 300px; overflow-y: auto; background: rgba(0,0,0,0.15); border-radius: 6px; padding: 8px 0;">
        {%- if section.settings.mega_col_1_menu != blank or section.settings.mega_col_2_menu != blank or section.settings.mega_col_3_menu != blank or section.settings.mega_col_4_menu != blank -%}
          {%- if section.settings.mega_col_1_menu != blank -%}
            {%- for link in linklists[section.settings.mega_col_1_menu].links -%}
              <li><a href="{{ link.url }}" class="sidebar-sub-item" style="color: #FBF7EE; opacity: 0.85; padding: 8px 12px; display: block; text-decoration: none; font-size: 0.9rem;">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- endif -%}
          {%- if section.settings.mega_col_2_menu != blank -%}
            {%- for link in linklists[section.settings.mega_col_2_menu].links -%}
              <li><a href="{{ link.url }}" class="sidebar-sub-item" style="color: #FBF7EE; opacity: 0.85; padding: 8px 12px; display: block; text-decoration: none; font-size: 0.9rem;">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- endif -%}
          {%- if section.settings.mega_col_3_menu != blank -%}
            {%- for link in linklists[section.settings.mega_col_3_menu].links -%}
              <li><a href="{{ link.url }}" class="sidebar-sub-item" style="color: #FBF7EE; opacity: 0.85; padding: 8px 12px; display: block; text-decoration: none; font-size: 0.9rem;">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- endif -%}
          {%- if section.settings.mega_col_4_menu != blank -%}
            {%- for link in linklists[section.settings.mega_col_4_menu].links -%}
              <li><a href="{{ link.url }}" class="sidebar-sub-item" style="color: #FBF7EE; opacity: 0.85; padding: 8px 12px; display: block; text-decoration: none; font-size: 0.9rem;">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- endif -%}
        {%- else -%}
          <!-- Complete list of 28 categories with translation checks -->
          {%- assign default_cats = "holy-quran:Holy Quran,islam:Islam,hadith:Hadith,tafsir:Tafsir,seerat-un-nabi:Seerat un Nabi,tasawuf:Tasawuf,fiqh:Fiqh,history:History,novel:Novel,poetry:Poetry,biography:Biography,short-stories:Short Stories,drama:Drama,essays:Essays,urdu-literature:Urdu Literature,children:Children,philosophy:Philosophy,psychology:Psychology,science:Science,education:Education,politics:Politics,pakistan:Pakistan,translations:Translations,travelogue:Travelogue,general-knowledge:General Knowledge,cooking:Cooking,sports:Sports,css-pms:CSS / PMS" | split: "," -%}
          {%- for cat_item in default_cats -%}
            {%- assign cat_parts = cat_item | split: ":" -%}
            {%- assign cat_handle = cat_parts[0] -%}
            {%- assign cat_name = cat_parts[1] -%}
            
            {%- assign translated_name = cat_name -%}
            {%- if request.locale.iso_code == 'ur' -%}
              {%- case cat_name -%}
                {%- when 'Holy Quran' -%}{%- assign translated_name = 'قرآن مجید' -%}
                {%- when 'Islam' -%}{%- assign translated_name = 'اسلامک کتب' -%}
                {%- when 'Hadith' -%}{%- assign translated_name = 'حدیث مبارکہ' -%}
                {%- when 'Tafsir' -%}{%- assign translated_name = 'تفسیر' -%}
                {%- when 'Seerat un Nabi' -%}{%- assign translated_name = 'سیرت النبی ﷺ' -%}
                {%- when 'Tasawuf' -%}{%- assign translated_name = 'تصوف' -%}
                {%- when 'Fiqh' -%}{%- assign translated_name = 'فقہ' -%}
                {%- when 'History' -%}{%- assign translated_name = 'تاریخی کتب' -%}
                {%- when 'Novel' -%}{%- assign translated_name = 'ناولز' -%}
                {%- when 'Poetry' -%}{%- assign translated_name = 'شاعری' -%}
                {%- when 'Biography' -%}{%- assign translated_name = 'سوانح عمری' -%}
                {%- when 'Short Stories' -%}{%- assign translated_name = 'افسانے' -%}
                {%- when 'Drama' -%}{%- assign translated_name = 'ڈرامہ' -%}
                {%- when 'Essays' -%}{%- assign translated_name = 'مضامین' -%}
                {%- when 'Urdu Literature' -%}{%- assign translated_name = 'اردو ادب' -%}
                {%- when 'Children' -%}{%- assign translated_name = 'بچوں کی کتب' -%}
                {%- when 'Philosophy' -%}{%- assign translated_name = 'فلسفہ' -%}
                {%- when 'Psychology' -%}{%- assign translated_name = 'نفسیات' -%}
                {%- when 'Science' -%}{%- assign translated_name = 'سائنس' -%}
                {%- when 'Education' -%}{%- assign translated_name = 'تعلیم' -%}
                {%- when 'Politics' -%}{%- assign translated_name = 'سیاسیات' -%}
                {%- when 'Pakistan' -%}{%- assign translated_name = 'پاکستان' -%}
                {%- when 'Translations' -%}{%- assign translated_name = 'تراجم' -%}
                {%- when 'Travelogue' -%}{%- assign translated_name = 'سفرنامے' -%}
                {%- when 'General Knowledge' -%}{%- assign translated_name = 'جنرل نالج' -%}
                {%- when 'Cooking' -%}{%- assign translated_name = 'ککنگ' -%}
                {%- when 'Sports' -%}{%- assign translated_name = 'کھیل' -%}
                {%- when 'CSS / PMS' -%}{%- assign translated_name = 'CSS / PMS' -%}
              {%- endcase -%}
            {%- endif -%}
            <li><a href="/collections/{{ cat_handle }}" class="sidebar-sub-item" style="color: #FBF7EE; opacity: 0.95; padding: 6px 12px; display: block; text-decoration: none; font-size: 0.9rem;">{{ translated_name }}</a></li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </li>

    <!-- 4. Discount -->
    <li>
      <a href="/collections/discount" class="sidebar-nav-item" style="color: white; padding: 12px 20px; display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 600;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
        {%- if request.locale.iso_code == 'ur' -%}رعایتی کتب{%- else -%}Discount{%- endif -%}
      </a>
    </li>

    <!-- 5. Upto 300 -->
    <li>
      <a href="/collections/upto-300" class="sidebar-nav-item" style="color: white; padding: 12px 20px; display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 600;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="12" y1="4" x2="12" y2="20"/><line x1="2" y1="12" x2="22" y2="12"/></svg>
        {%- if request.locale.iso_code == 'ur' -%}300 تک{%- else -%}Upto 300{%- endif -%}
      </a>
    </li>

    <!-- 6. New Arrivals -->
    <li>
      <a href="/collections/new-arrivals" class="sidebar-nav-item" style="color: white; padding: 12px 20px; display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 600;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        {%- if request.locale.iso_code == 'ur' -%}نئی آمد{%- else -%}New Arrivals{%- endif -%}
      </a>
    </li>

    <!-- 7. Upcoming -->
    <li>
      <a href="/collections/upcoming" class="sidebar-nav-item" style="color: white; padding: 12px 20px; display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 600;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        {%- if request.locale.iso_code == 'ur' -%}آنے والی کتب{%- else -%}Upcoming{%- endif -%}
      </a>
    </li>

    <!-- 8. Request A Book -->
    <li>
      <a href="/pages/request-a-book" class="sidebar-nav-item" style="color: white; padding: 12px 20px; display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 600;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        {%- if request.locale.iso_code == 'ur' -%}کتاب منگوائیں{%- else -%}Request A Book{%- endif -%}
      </a>
    </li>

    <!-- 9. Catalogue -->
    <li>
      <a href="/pages/catalogue" class="sidebar-nav-item" style="color: white; padding: 12px 20px; display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 600;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        {%- if request.locale.iso_code == 'ur' -%}کیٹالاگ{%- else -%}Catalogue{%- endif -%}
      </a>
    </li>

    <div class="sidebar-nav-divider" style="height: 1px; background: rgba(255,255,255,0.1); margin: 10px 20px;"></div>

    <!-- 10. How To Pay -->
    <li>
      <a href="/pages/how-to-pay" class="sidebar-nav-item" style="color: white; padding: 12px 20px; display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 600;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
        {%- if request.locale.iso_code == 'ur' -%}طریقہ ادائیگی{%- else -%}How To Pay{%- endif -%}
      </a>
    </li>

    <!-- 11. Contact Us -->
    <li>
      <a href="/pages/contact" class="sidebar-nav-item" style="color: white; padding: 12px 20px; display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 600;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M22 16.92v3a2 2 0 0 0-2.18 2 19.79 19.79 0 0 0-8.63-3.07 19.5 19.5 0 0 0-6 6 19.79 19.79 0 0 0-3.07 8.67A2 2 0 0 0 4.11 23h3a2 2 0 0 0 2-1.72 12.84 12.84 0 0 1 .7-2.81 2 2 0 0 1-.45-2.11L8.09 9.91a16 16 0 0 1 7-7l1.27 1.27a2 2 0 0 1 2.11.45 12.84 12.84 0 0 1 2.81-.7A2 2 0 0 1 22 17.92z"/></svg>
        {%- if request.locale.iso_code == 'ur' -%}رابطہ کریں{%- else -%}Contact Us{%- endif -%}
      </a>
    </li>
  </ul>
</nav>
