{% comment %}
  KITAB WALA - STAR RATING SNIPPET
  Usage: {% render 'rating', product: product %}
{% endcomment %}

{%- assign rating = product.metafields.reviews.rating.value | default: '4.5' | times: 1.0 -%}
{%- assign review_count = product.metafields.reviews.rating_count | default: '1.2k' -%}

<div class="product-card-rating" aria-label="{{ rating }} out of 5 stars ({{ review_count }} reviews)">
  <div class="star-icons" role="img">
    {%- for i in (1..5) -%}
      {%- if i <= rating -%}
        <span class="star-icon" aria-hidden="true">★</span>
      {%- elsif i <= rating | plus: 0.5 -%}
        <span class="star-icon" aria-hidden="true" style="opacity:.6;">★</span>
      {%- else -%}
        <span class="star-icon" aria-hidden="true" style="color:#ddd;">★</span>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <span class="rating-count">({{ review_count }})</span>
</div>
