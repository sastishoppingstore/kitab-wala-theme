{% layout 'password' %}

<div class="password-page">
  <div class="password-logo">{{ shop.name }}</div>
  <p class="password-subtitle">
    {%- if request.locale.iso_code == 'ur' -%}
      {{ 'general.password_page.coming_soon' | t | default: 'ہم جلد آ رہے ہیں۔ ابھی کے لیے پاس ورڈ درج کریں۔' }}
    {%- else -%}
      {{ 'general.password_page.coming_soon' | t | default: 'We are coming soon. Please enter the password to access.' }}
    {%- endif -%}
  </p>
  {% form 'storefront_password' %}
    <div class="password-form">
      <input class="password-input" type="password" name="password" placeholder="{%- if request.locale.iso_code == 'ur' -%}پاس ورڈ{%- else -%}Password{%- endif -%}">
      <button type="submit" class="password-btn">
        {%- if request.locale.iso_code == 'ur' -%}داخل ہوں{%- else -%}Enter{%- endif -%}
      </button>
    </div>
  {% endform %}
  <div class="password-links">
    {{ powered_by_link }}
  </div>
</div>
