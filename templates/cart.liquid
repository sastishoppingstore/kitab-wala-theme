{% comment %}
  KITAB WALA - CART TEMPLATE
  App-style clean shopping cart template with localization support.
{% endcomment %}

<div class="cart-container" style="max-width: 800px; margin: 40px auto; padding: 0 20px; font-family: 'Inter', sans-serif; color: var(--color-text-main);">
  <h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 24px; text-align: {% if request.locale.iso_code == 'ur' %}right{% else %}left{% endif %};">
    {%- if request.locale.iso_code == 'ur' -%}شاپنگ کارٹ{%- else -%}Shopping Cart{%- endif -%}
  </h1>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-form" style="display: grid; gap: 30px; grid-template-columns: 1fr;">
      
      <!-- Cart Items Table -->
      <div class="cart-items" style="background: white; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.05); padding: 20px; display: flex; flex-direction: column; gap: 20px;">
        {%- for item in cart.items -%}
          <div class="cart-item" style="display: flex; gap: 16px; border-bottom: 1px solid rgba(0,0,0,0.06); padding-bottom: 20px; align-items: center; justify-content: space-between; flex-direction: {% if request.locale.iso_code == 'ur' %}row-reverse{% else %}row{% endif %};">
            <!-- Image & Info -->
            <div style="display: flex; gap: 16px; align-items: center; flex-direction: {% if request.locale.iso_code == 'ur' %}row-reverse{% else %}row{% endif %};">
              <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title }}" style="width: 70px; height: auto; border-radius: 6px; background: #f5f0e8;">
              <div style="text-align: {% if request.locale.iso_code == 'ur' %}right{% else %}left{% endif %};">
                <a href="{{ item.url }}" style="font-weight: 700; text-decoration: none; color: var(--color-primary); font-size: 1rem; display: block; margin-bottom: 4px;">{{ item.product.title }}</a>
                <span style="font-size: 0.85rem; color: #888; display: block; margin-bottom: 8px;">{{ item.vendor }}</span>
                <span style="font-weight: 600; color: var(--color-text-main); font-size: 0.95rem;">{{ item.final_line_price | money }}</span>
              </div>
            </div>
            
            <!-- Quantity controls & Remove -->
            <div style="display: flex; flex-direction: column; align-items: {% if request.locale.iso_code == 'ur' %}flex-start{% else %}flex-end{% endif %}; gap: 8px;">
              <div style="display: flex; align-items: center; border: 1px solid rgba(0,0,0,0.1); border-radius: 6px; overflow: hidden; background: #f9f9f9; height: 32px;">
                <a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" style="padding: 0 10px; text-decoration: none; color: #333; font-weight: bold; line-height: 32px;">-</a>
                <span style="padding: 0 10px; font-weight: 600; line-height: 32px; font-size: 0.9rem;">{{ item.quantity }}</span>
                <a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" style="padding: 0 10px; text-decoration: none; color: #333; font-weight: bold; line-height: 32px;">+</a>
              </div>
              <a href="/cart/change?line={{ forloop.index }}&quantity=0" style="font-size: 0.8rem; color: #e74c3c; text-decoration: none;">
                {%- if request.locale.iso_code == 'ur' -%}حذف کریں{%- else -%}Remove{%- endif -%}
              </a>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <!-- Subtotal and checkout actions -->
      <div class="cart-summary" style="background: white; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.05); padding: 24px; text-align: {% if request.locale.iso_code == 'ur' %}right{% else %}left{% endif %}; display: flex; flex-direction: column; gap: 16px;">
        <div style="display: flex; justify-content: space-between; font-size: 1.1rem; font-weight: 700; border-bottom: 1px solid rgba(0,0,0,0.06); padding-bottom: 12px; flex-direction: {% if request.locale.iso_code == 'ur' %}row-reverse{% else %}row{% endif %};">
          <span>{%- if request.locale.iso_code == 'ur' -%}کل قیمت (سب ٹوٹل):{%- else -%}Subtotal:{%- endif -%}</span>
          <span style="color: var(--color-primary);">{{ cart.total_price | money }}</span>
        </div>
        <p style="font-size: 0.85rem; color: #666; margin: 0; line-height: 1.4;">
          {%- if request.locale.iso_code == 'ur' -%}
            ٹیکس اور شپنگ کی فیس چیک آؤٹ کے وقت شامل کی جائے گی۔
          {%- else -%}
            Taxes and shipping calculated at checkout.
          {%- endif -%}
        </p>
        <div style="display: flex; gap: 12px; margin-top: 10px; flex-direction: {% if request.locale.iso_code == 'ur' %}row-reverse{% else %}row{% endif %};">
          <button type="submit" name="update" class="btn btn-outline" style="border: 1px solid var(--color-primary); color: var(--color-primary); background: none; padding: 12px 24px; border-radius: 8px; font-weight: 700; cursor: pointer; flex: 1;">
            {%- if request.locale.iso_code == 'ur' -%}اپ ڈیٹ کریں{%- else -%}Update Cart{%- endif -%}
          </button>
          <button type="submit" name="checkout" class="btn btn-primary" style="background: var(--color-primary); color: white; border: none; padding: 12px 24px; border-radius: 8px; font-weight: 700; cursor: pointer; flex: 2; transition: background 0.2s ease;">
            {%- if request.locale.iso_code == 'ur' -%}چیک آؤٹ کریں{%- else -%}Proceed to Checkout{%- endif -%}
          </button>
        </div>
      </div>

    </form>
  {%- else -%}
    <div style="background: white; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.05); padding: 40px 20px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 16px;">
      <span style="font-size: 3rem;">🛒</span>
      <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0;">
        {%- if request.locale.iso_code == 'ur' -%}آپ کی کارٹ خالی ہے۔{%- else -%}Your cart is empty{%- endif -%}
      </h2>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary" style="background: var(--color-primary); color: white; text-decoration: none; padding: 12px 24px; border-radius: 8px; font-weight: 700; display: inline-block;">
        {%- if request.locale.iso_code == 'ur' -%}خریداری جاری رکھیں{%- else -%}Continue Shopping{%- endif -%}
      </a>
    </div>
  {%- endif -%}
</div>
