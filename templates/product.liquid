{% comment %}
  KITAB WALA - PRODUCT PAGE TEMPLATE (Strictly English UI with Urdu description and dual titles)
{% endcomment %}

<div class="product-page container" style="max-width: 1200px; margin: 0 auto; padding: 40px 20px;">
  <div class="product-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px; margin-bottom: 40px;">
    
    <!-- Left Column: Product Gallery / 3D Book -->
    <div class="product-gallery" style="display: flex; flex-direction: column; align-items: center; justify-content: center; background: #fafafa; border-radius: 12px; padding: 30px; position: relative;">
      {% render 'product-card-3d', product: product %}
    </div>

    <!-- Right Column: Product Information -->
    <div class="product-info" style="display: flex; flex-direction: column; justify-content: flex-start;">
      {%- if product.collections.first -%}
        <a href="{{ product.collections.first.url }}" style="font-size:0.85rem;color:var(--color-orange);text-decoration:none;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;">
          {{ product.collections.first.title }}
        </a>
      {%- endif -%}

      <h1 class="product-info-title" style="margin-top:8px; font-size: 2rem; color: var(--color-primary); font-weight: 800; line-height: 1.3;">
        {%- if product.metafields.custom.title_urdu != blank -%}
          {{ product.title }} - {{ product.metafields.custom.title_urdu }}
        {%- else -%}
          {{ product.title }}
        {%- endif -%}
      </h1>



      {% render 'rating', product: product %}

      <div style="margin: 20px 0;">
        {% render 'price', product: product %}
      </div>

      <!-- Description Block (strictly in Urdu with RTL style) -->
      {%- assign product_desc_ur = product.metafields.custom.description_urdu | default: product.description -%}
      {%- if product_desc_ur != blank -%}
        <div class="product-description-urdu" style="direction:rtl; font-family:'Noto Nastaliq Urdu', serif; font-size:1.05rem; color:var(--color-text-secondary); line-height:2.2; margin-bottom:24px; border-top:1px solid rgba(0,0,0,0.06); padding-top:18px; text-align: right;">
          {{ product_desc_ur }}
        </div>
      {%- endif -%}

      {%- if product.has_only_default_variant == false -%}
        <form id="product-form" method="post" action="{{ routes.cart_add_url }}" enctype="multipart/form-data">
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">
          {%- for option in product.options_with_values -%}
            <div style="margin-bottom:16px;">
              <p style="font-size:0.88rem;font-weight:700;margin-bottom:8px;color:var(--color-primary);">{{ option.name }}</p>
              <div style="display:flex;flex-wrap:wrap;gap:8px;">
                {%- for value in option.values -%}
                  <label style="cursor:pointer;">
                    <input type="radio" name="options[{{ option.name }}]" value="{{ value }}" style="display:none;">
                    <span style="display:inline-block;padding:8px 16px;border:2px solid var(--color-border);border-radius:8px;font-size:0.88rem;font-weight:600;transition:all .3s;">{{ value }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
          <input type="hidden" name="id" value="{{ product.first_available_variant.id }}" id="variant-id">
        </form>
      {%- endif -%}

      <div class="quantity-selector" style="margin-bottom:24px; display: flex; align-items: center; gap: 8px;">
        <button class="quantity-btn quantity-decrease" aria-label="Decrease" style="width: 36px; height: 36px; border: 1px solid rgba(0,0,0,0.1); background: white; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 1.1rem;">−</button>
        <input class="quantity-input" type="number" name="quantity" value="1" min="1" max="{{ product.first_available_variant.inventory_quantity | default: 99 }}" style="width: 50px; height: 36px; text-align: center; border: 1px solid rgba(0,0,0,0.1); border-radius: 4px; font-weight: bold;">
        <button class="quantity-btn quantity-increase" aria-label="Increase" style="width: 36px; height: 36px; border: 1px solid rgba(0,0,0,0.1); background: white; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 1.1rem;">+</button>
      </div>

      <div class="product-action-btns" style="display: flex; gap: 14px;">
        {%- if product.available -%}
          <button
            class="btn btn-primary btn-ripple"
            data-add-to-cart
            data-variant-id="{{ product.first_available_variant.id }}"
            style="flex:1; padding: 14px 24px; font-weight: 700; border-radius: 50px; background: var(--color-primary); color: white; border: none; cursor: pointer; transition: all 0.3s;"
          >
            {{ 'products.product.add_to_cart' | t | default: 'Add to Cart' }}
          </button>
          <a href="{{ product.url }}" class="btn btn-ripple btn-orange" style="flex:1; text-align: center; padding: 14px 24px; font-weight: 700; border-radius: 50px; background: var(--color-orange); color: white; border: none; text-decoration: none; transition: all 0.3s;">
            {{ 'products.product.order_now' | t | default: 'Order Now' }}
          </a>
          <!-- Wishlist Button -->
          <button class="product-card-wishlist product-page-wishlist" 
                  data-product-id="{{ product.id }}" 
                  data-product-variant-id="{{ product.first_available_variant.id }}"
                  data-product-title="{{ product.title | escape }}"
                  data-product-url="{{ product.url }}"
                  data-product-img="{% if product.featured_image %}{{ product.featured_image | image_url: width: 300 }}{% endif %}"
                  data-product-price="{{ product.price | money_without_trailing_zeros }}"
                  data-product-vendor="{{ product.vendor | escape }}"
                  aria-label="Add to wishlist" 
                  style="position: static; width: 48px; height: 48px; border-radius: 50%; border: 1px solid rgba(14, 58, 47, 0.15); background: white; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s ease;">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" style="fill: #ccc; transition: fill 0.2s ease;"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
          </button>
          <style>
            .product-page-wishlist.active svg {
              fill: #e74c3c !important;
            }
          </style>
        {%- else -%}
          <button class="btn btn-primary" disabled style="flex:1; padding: 14px 24px; font-weight: 700; border-radius: 50px; background: #ccc; color: white; border: none; cursor: not-allowed; opacity: 0.7;">
            {{ 'products.product.sold_out' | t | default: 'Sold Out' }}
          </button>
        {%- endif -%}
      </div>

      <table class="product-meta-table" style="margin-top:30px; border-collapse: collapse; width: 100%; border-top: 1px solid rgba(0,0,0,0.06);">
        {%- if product.metafields.custom.isbn != blank -%}
          <tr style="border-bottom: 1px solid rgba(0,0,0,0.06);"><td style="padding: 10px 0; font-weight: 600; color: var(--color-primary);">ISBN</td><td style="padding: 10px 0; color: var(--color-text-secondary);">{{ product.metafields.custom.isbn }}</td></tr>
        {%- endif -%}
        {%- if product.metafields.custom.edition != blank -%}
          <tr style="border-bottom: 1px solid rgba(0,0,0,0.06);">
            <td style="padding: 10px 0; font-weight: 600; color: var(--color-primary);">{{ 'products.product.edition' | t | default: 'Edition' }}</td>
            <td style="padding: 10px 0; color: var(--color-text-secondary);">{{ product.metafields.custom.edition }}</td>
          </tr>
        {%- endif -%}
        {%- if product.type != blank -%}
          <tr style="border-bottom: 1px solid rgba(0,0,0,0.06);">
            <td style="padding: 10px 0; font-weight: 600; color: var(--color-primary);">{{ 'products.product.type' | t | default: 'Type' }}</td>
            <td style="padding: 10px 0; color: var(--color-text-secondary);">{{ product.type }}</td>
          </tr>
        {%- endif -%}
        {%- if product.vendor != blank -%}
          <tr style="border-bottom: 1px solid rgba(0,0,0,0.06);">
            <td style="padding: 10px 0; font-weight: 600; color: var(--color-primary);">{{ 'products.product.vendor' | t | default: 'Brand' }}</td>
            <td style="padding: 10px 0; color: var(--color-text-secondary);">{{ product.vendor }}</td>
          </tr>
        {%- endif -%}
      </table>
    </div>
  </div>

  {%- if product.metafields.reviews.rating != blank or settings.enable_product_reviews -%}
  <div class="reviews-section" style="margin-top: 50px; border-top: 1px solid rgba(0,0,0,0.08); padding-top: 30px;">
    <h2 class="section-title" style="font-size: 1.5rem; font-weight: 700; color: var(--color-primary); margin-bottom: 20px;">{{ 'products.product.reviews' | t | default: 'Reader Reviews' }}</h2>
    {%- if product.metafields.reviews.rating != blank -%}
      <div style="margin-bottom:20px;">
        {% render 'rating', product: product %}
      </div>
    {%- endif -%}

    {%- if product.metafields.reviews.reviews != blank -%}
      {%- for review in product.metafields.reviews.reviews.value -%}
        <div class="review-card" style="background: #fafafa; border-radius: 8px; padding: 16px; margin-bottom: 16px;">
          <div class="review-header" style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.85rem; color: #666;">
            <span class="reviewer-name" style="font-weight: bold; color: var(--color-primary);">{{ review.author }}</span>
            <span class="review-date">{{ review.date | date: '%Y-%m-%d' }}</span>
          </div>
          <div class="star-icons" style="margin-bottom:8px; color: #f5a623;">
            {%- for i in (1..review.rating) -%}
              <span class="star-icon">★</span>
            {%- endfor -%}
          </div>
          <p class="review-body" style="font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.5;">{{ review.body }}</p>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="review-card" style="background: #fafafa; border-radius: 8px; padding: 16px; margin-bottom: 16px;">
        <div class="review-header" style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.85rem; color: #666;">
          <span class="reviewer-name" style="font-weight: bold; color: var(--color-primary);">Ali Khan</span>
          <span class="review-date">2024-01-15</span>
        </div>
        <div class="star-icons" style="margin-bottom:8px; color: #f5a623;"><span class="star-icon">★</span><span class="star-icon">★</span><span class="star-icon">★</span><span class="star-icon">★</span><span class="star-icon">★</span></div>
        <p class="review-body" style="font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.5;">Excellent book, quality is superb and delivery was fast.</p>
      </div>
      <div class="review-card" style="background: #fafafa; border-radius: 8px; padding: 16px; margin-bottom: 16px;">
        <div class="review-header" style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.85rem; color: #666;">
          <span class="reviewer-name" style="font-weight: bold; color: var(--color-primary);">Fatima Noor</span>
          <span class="review-date">2024-01-10</span>
        </div>
        <div class="star-icons" style="margin-bottom:8px; color: #f5a623;"><span class="star-icon">★</span><span class="star-icon">★</span><span class="star-icon">★</span><span class="star-icon">★</span><span class="star-icon" style="color:#ddd;">★</span></div>
        <p class="review-body" style="font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.5;">Good book, nice packaging.</p>
      </div>
    {%- endif -%}
  </div>
  {%- endif -%}

  <div class="faq-section" style="margin-top: 40px; border-top: 1px solid rgba(0,0,0,0.08); padding-top: 30px;">
    <h2 class="section-title" style="font-size: 1.5rem; font-weight: 700; color: var(--color-primary); margin-bottom: 20px;">Frequently Asked Questions</h2>
    <div class="faq-item" style="margin-bottom: 16px; border-bottom: 1px solid rgba(0,0,0,0.04); padding-bottom: 12px;">
      <div class="faq-question" style="font-weight: 700; color: var(--color-primary); margin-bottom: 6px; font-size: 0.95rem;">How long does delivery take?</div>
      <div class="faq-answer" style="font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.5;">Usually 3-5 business days. Lahore, Karachi, Islamabad receive orders in 1-2 days.</div>
    </div>
    <div class="faq-item" style="margin-bottom: 16px; border-bottom: 1px solid rgba(0,0,0,0.04); padding-bottom: 12px;">
      <div class="faq-question" style="font-weight: 700; color: var(--color-primary); margin-bottom: 6px; font-size: 0.95rem;">What is the return policy?</div>
      <div class="faq-answer" style="font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.5;">If the book is damaged or incorrect, return within 7 days for a full refund.</div>
    </div>
    <div class="faq-item" style="margin-bottom: 16px; padding-bottom: 12px;">
      <div class="faq-question" style="font-weight: 700; color: var(--color-primary); margin-bottom: 6px; font-size: 0.95rem;">Is Cash on Delivery available?</div>
      <div class="faq-answer" style="font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.5;">Yes, COD is available nationwide across Pakistan.</div>
    </div>
  </div>

  {%- section 'product-related' -%}
</div>
